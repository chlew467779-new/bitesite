# bitesite/.env.example  — variable NAMES only. Never commit real values.

# ── Supabase (public, safe for the browser) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (SERVER-ONLY secret) ───────────────────────────────────────
# Bypasses Row Level Security. Used only by lib/supabase-admin.ts (server code).
# MUST NOT start with NEXT_PUBLIC_. Set it in Vercel as a server env var and
# only for the environments that need it. Never paste it into chat, tickets or git.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin panel (server-only) ───────────────────────────────────────────
ADMIN_PASSWORD=
# Required for issuing and verifying admin session tokens. Use a distinct,
# high-entropy random value (at least 32 bytes); never expose it to the browser.
# Set this in every Vercel environment before deploying the session-secret change.
ADMIN_SESSION_SECRET=
# Optional: key for hashing visitor IPs on "Report a problem" (no raw IP is stored). Falls back to
# ADMIN_SESSION_SECRET when unset; set a distinct random value to keep the two independent.
REPORT_HASH_SECRET=

# ── AI drafting (SERVER-ONLY secret) ────────────────────────────────────
GOOGLE_AI_API_KEY=

# ── Optional: Google Analytics 4 ────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Canonical site URL (optional; defaults to Production) ───────────────
NEXT_PUBLIC_SITE_URL=https://bitesite-pied.vercel.app

# Review notification emails (optional; nothing is sent without them). See docs/RELEASE_ORDER.md §12.
RESEND_API_KEY=
NOTIFY_FROM=
ADMIN_NOTIFY_EMAIL=
CRON_SECRET=
